# Arquivo de EXEMPLO — não contém valores reais. Copie para ".env.local" (uso
# local) ou configure estas mesmas chaves no painel do provedor de hospedagem
# (ex.: Vercel > Project Settings > Environment Variables) para produção.
# Nunca commite um arquivo ".env" ou ".env.local" com valores reais.
#
# A maioria destas variáveis NÃO usa o prefixo "VITE_": elas são lidas apenas
# pela função de servidor em api/contact.ts, nunca pelo bundle público do
# navegador. A exceção é VITE_WHATSAPP_NUMBER, documentada abaixo — números de
# WhatsApp são públicos por natureza (aparecem no link gerado de qualquer forma).

# Número de WhatsApp usado pelo botão flutuante e pelos CTAs do site, com DDI
# e sem símbolos (ex.: "5511999999999"). Opcional: sem esta variável, o site
# usa o número já verificado e centralizado em src/config/site.ts. Defina esta
# variável apenas se o número precisar mudar sem editar código.
VITE_WHATSAPP_NUMBER=

# Qual provedor de envio a API de contato deve usar: "resend" | "webhook" | "none".
# Enquanto estiver "none" (ou vazio), a API valida a submissão normalmente mas
# responde com um status de configuração pendente em vez de simular sucesso.
CONTACT_PROVIDER=none

# --- Provedor "resend" (https://resend.com) ---
# Chave de API privada do Resend. NUNCA prefixe com VITE_. Mantenha apenas no
# cofre de variáveis do provedor de hospedagem.
RESEND_API_KEY=
# Endereço de e-mail que enviará a notificação (precisa ser um domínio/remetente
# verificado no Resend).
CONTACT_FROM_EMAIL=
# Endereço de e-mail que deve receber os pedidos de contato do site.
CONTACT_TO_EMAIL=

# --- Provedor "webhook" (alternativa: n8n, Make, Zapier, endpoint próprio) ---
# URL HTTPS que receberá um POST com o payload validado do formulário.
WEBHOOK_URL=

# Origem(ns) autorizadas a chamar a API em produção, separadas por vírgula.
# Em desenvolvimento local, http://localhost:5173 já é liberado automaticamente.
ALLOWED_ORIGIN=https://efsa.com.br

# --- Meta Pixel / Conversions API (rastreamento de leads para o Meta Business Suite) ---
# ID do Pixel (mesmo valor já usado no <script> do Pixel em index.html). Não é
# um segredo — aparece publicamente em qualquer página com o Pixel instalado.
META_PIXEL_ID=
# Token de acesso da Conversions API (CAPI), gerado em Meta Events Manager >
# Configurações > Conversions API. Este SIM é um segredo — nunca prefixe com
# VITE_, nunca commite, mantenha apenas no cofre de variáveis do provedor de
# hospedagem. Enquanto vazio, o envio via CAPI fica desativado automaticamente
# (o Pixel do navegador continua funcionando normalmente).
META_CAPI_ACCESS_TOKEN=
