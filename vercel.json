{
  "framework": "vite",
  "installCommand": "yarn install",
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/obrigado",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.efsa.com.br" }],
      "destination": "https://efsa.com.br/:path*",
      "permanent": true
    },
    { "source": "/solucoes", "destination": "/#solucoes", "permanent": true },
    { "source": "/contato", "destination": "/#contato", "permanent": true },
    { "source": "/criacao-de-sites", "destination": "/#solucoes", "permanent": true },
    { "source": "/sistemas-personalizados", "destination": "/#solucoes", "permanent": true },
    { "source": "/automacao-whatsapp", "destination": "/#solucoes", "permanent": true },
    { "source": "/seo-e-divulgacao", "destination": "/#solucoes", "permanent": true },
    { "source": "/sobre", "destination": "/", "permanent": true }
  ]
}
