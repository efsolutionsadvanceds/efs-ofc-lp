{
  "framework": "vite",
  "installCommand": "yarn install",
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.efsa.com.br" }],
      "destination": "https://efsa.com.br/:path*",
      "permanent": true
    },
    { "source": "/criacao-de-sites", "destination": "/solucoes#sites", "permanent": true },
    { "source": "/sistemas-personalizados", "destination": "/solucoes#sistemas", "permanent": true },
    { "source": "/automacao-whatsapp", "destination": "/solucoes#automacao", "permanent": true },
    { "source": "/seo-e-divulgacao", "destination": "/solucoes#divulgacao", "permanent": true },
    { "source": "/sobre", "destination": "/solucoes", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
